# Dependencies
node_modules/
venv/
.venv/
__pycache__/
*.pyc

# Environment / secrets
.env
.env.*
!.env.example

# Build output
dist/
build/
*.egg-info/

# Python test/tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Logs
*.log
npm-debug.log*

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Generated resumes / applications (local artifacts, not source)
output/
generated/
career-agent/data/cvs/*
!career-agent/data/cvs/.gitkeep
!career-agent/data/cvs/README.md
career-agent/data/application_materials/*
!career-agent/data/application_materials/.gitkeep
!career-agent/data/application_materials/README.md

# Step 5: real browser profile (cookies/local storage/cache -- never
# credentials, since the agent never automates login) and per-application
# session artifacts (screenshots, if BROWSER_SCREENSHOTS=true). Neither
# belongs in source control.
career-agent/data/browser_profile/*
!career-agent/data/browser_profile/.gitkeep
!career-agent/data/browser_profile/README.md
career-agent/data/application_sessions/*
!career-agent/data/application_sessions/.gitkeep
!career-agent/data/application_sessions/README.md

# Step 6: local database backups (python -m app.cli backup) -- contain a
# full dump of your career/application data, never checked in.
career-agent/data/backups/*
!career-agent/data/backups/.gitkeep
!career-agent/data/backups/README.md

# LaTeX build byproducts (should never survive compile_pdf() anyway, but
# just in case pdflatex is interrupted mid-run)
*.aux
*.out
