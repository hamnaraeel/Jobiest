DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/career_agent
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set AI_PROVIDER=groq to run JD analysis, matching, CV customization, and
# resume parsing on Groq's free OpenAI-compatible API instead of OpenAI --
# get a free key at https://console.groq.com. Leave as "openai" (default)
# to use OPENAI_API_KEY/OPENAI_MODEL above for those four services.
AI_PROVIDER=openai
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
CV_MAX_PAGES=2
CV_STORAGE_DIR=../data/cvs
PDFLATEX_PATH=pdflatex
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
COVER_LETTER_MIN_WORDS=250
COVER_LETTER_MAX_WORDS=400
APPLICATION_MATERIALS_DIR=../data/application_materials
# Step 5: browser-based application assistant. Keep DRY_RUN=true until
# you've reviewed the workflow -- it makes every submission simulated
# regardless of approval. BROWSER_HEADLESS=false shows the browser window
# so you can watch/intervene (log in, solve a CAPTCHA, etc).
DRY_RUN=true
BROWSER_HEADLESS=false
BROWSER_TYPE=chromium
BROWSER_PROFILE_DIR=../data/browser_profile
BROWSER_SCREENSHOTS=false
APPLICATION_SESSIONS_DIR=../data/application_sessions
FIELD_CONFIDENCE_HIGH=0.90
FIELD_CONFIDENCE_MEDIUM=0.70
